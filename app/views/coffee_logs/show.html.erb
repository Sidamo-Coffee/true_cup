<% content_for :title, t(".title") %>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold"><%= t(".title") %></h1>
    </div>

    <div class="flex gap-2">
      <%= link_to t(".actions.edit"), edit_coffee_log_path(@coffee_log), class: "px-3 py-2 rounded border text-sm hover:bg-gray-50" %>
      <%= link_to t(".actions.delete"), coffee_log_path(@coffee_log),
                  data: { turbo_method: :delete, turbo_confirm: t(".confirm_delete") },
                  class: "px-3 py-2 rounded border text-sm text-red-700 hover:bg-red-50" %>
    </div>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
    <div class="text-sm text-gray-700">
      <%= t(".labels.drank_on") %> : 
      <span class="text-sm text-gray-700 mt-1"><%= l @coffee_log.drank_on, format: :long %></span>
    </div>
    <div class="text-sm text-gray-700">
      <span class="text-gray-500"><%= t(".labels.place") %>：</span>
      <%= @coffee_log.place_label %>
      <% if @coffee_log.place_cafe? && @coffee_log.cafe_name.present? %>
        （<%= @coffee_log.cafe_name %>）
      <% end %>
    </div>

    <div>
      <p class="text-gray-700 text-sm"><%= t(".labels.coffee_name") %></p>
      <p class="text-lg font-semibold"><%= @coffee_log.coffee_name.presence || t(".values.coffee_name_blank") %></p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div class="p-4 rounded border">
        <p class="text-gray-500"><%= t(".labels.roast_level") %></p>
        <p class="font-semibold flex items-center gap-2">
          <%= render "shared/illustrations/coffee_bean", roast: @coffee_log.roast_level %>
          <%= @coffee_log.roast_level_label %>
        </p>
      </div>
      <div class="p-4 rounded border">
        <p class="text-gray-500"><%= t(".labels.rating") %></p>
        <p class="font-semibold"><%= "★" * @coffee_log.overall_rating %>（<%= @coffee_log.overall_rating %>）</p>
      </div>
      <div class="p-4 rounded border">
        <p class="text-gray-500"><%= t(".labels.acidity") %></p>
        <p class="font-semibold"><%= t("common.taste_levels.strength")[@coffee_log.acidity] %></p>
      </div>
      <div class="p-4 rounded border">
        <p class="text-gray-500"><%= t(".labels.bitterness") %></p>
        <p class="font-semibold"><%= t("common.taste_levels.strength")[@coffee_log.bitterness] %></p>
      </div>
    </div>

    <% if @coffee_log.memo.present? %>
      <div>
        <p class="text-gray-500 text-sm"><%= t(".labels.memo") %></p>
        <p class="text-gray-800 whitespace-pre-wrap"><%= @coffee_log.memo %></p>
      </div>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= link_to t(".actions.back"), coffee_logs_path, class: "px-4 py-2 rounded border" %>
    <%= link_to t(".actions.new"), new_coffee_log_path, class: "px-4 py-2 rounded bg-amber-700 text-white" %>
  </div>
</div>
