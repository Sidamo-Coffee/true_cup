<%= form_with model: coffee_log, class: "space-y-6" do |f| %>
  <% if coffee_log.errors.any? %>
    <div class="p-4 rounded border">
      <ul class="list-disc pl-5">
        <% coffee_log.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :drank_on, class: "block text-sm font-medium" %>
    <%= f.date_field :drank_on, class: "mt-1 w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :place, class: "block text-sm font-medium" %>
    <div class="mt-2 flex gap-6">
      <% CoffeeLog.places.keys.each do |key| %>
        <label class="inline-flex items-center gap-2">
          <%= f.radio_button :place, key %>
          <span><%= t("activerecord.enums.coffee_log.place.#{key}") %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= f.label :cafe_name, class: "block text-sm font-medium" %>
    <%= f.text_field :cafe_name, class: "mt-1 w-full rounded border px-3 py-2" %>
  </div>

  <div>
    <%= f.label :coffee_name, class: "block text-sm font-medium" %>
    <%= f.text_field :coffee_name, class: "mt-1 w-full rounded border px-3 py-2", placeholder: t(".coffee_name_placeholder") %>
  </div>

  <div>
    <%= f.label :roast_level, t(".roast_level_help"), class: "block text-sm font-medium" %>
    <div class="mt-2 flex flex-wrap gap-4">
      <% CoffeeLog.roast_levels.keys.each do |key| %>
        <label class="inline-flex items-center gap-2">
          <%= f.radio_button :roast_level, key %>
          <span><%= t(".roast_level_options.#{key}") %></span>
        </label>
<% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <p class="text-sm font-medium"><%= t("activerecord.attributes.coffee_log.acidity") %></p>
      <div class="mt-2 flex gap-6">
        <% t("common.taste_levels.strength").each_with_index do |label, v| %>
          <label class="inline-flex items-center gap-2">
            <%= f.radio_button :acidity, v %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div>
      <p class="text-sm font-medium"><%= t("activerecord.attributes.coffee_log.bitterness") %></p>
      <div class="mt-2 flex gap-6">
        <% t("common.taste_levels.strength").each_with_index do |label, v| %>
          <label class="inline-flex items-center gap-2">
            <%= f.radio_button :bitterness, v %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-medium"><%= t(".rating_help") %></p>
    <div class="mt-2 flex flex-wrap gap-4">
      <% (1..5).each do |v| %>
        <label class="inline-flex items-center gap-2">
          <%= f.radio_button :overall_rating, v %>
          <span><%= "★" * v %></span>
          <span class="text-xs text-gray-500">(<%= v %>)</span>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= f.label :memo, class: "block text-sm font-medium" %>
    <%= f.text_area :memo, rows: 3, class: "mt-1 w-full rounded border px-3 py-2" %>
  </div>

  <div class="flex gap-3">
    <%= f.submit submit_label, class: "px-4 py-2 rounded bg-amber-700 text-white" %>
    <%= link_to t(".back_to_index"), coffee_logs_path, class: "px-4 py-2 rounded border" %>
  </div>
<% end %>