<% content_for :title, "味覚診断結果" %>

<% roast_key = @taste_profile.preferred_roast.to_s %>

<% roast_label =
  case roast_key
  when "light"       then "浅煎り"
  when "medium"      then "中煎り"
  when "medium_dark" then "中深煎り"
  when "dark"        then "深煎り"
  else "コーヒータイプ"
  end
%>

<% tagline =
  case roast_key
  when "light"       then "爽やかフルーティ派"
  when "medium"      then "バランス派"
  when "medium_dark" then "香ばしコク派"
  when "dark"        then "どっしりビター派"
  else "あなたのタイプ"
  end
%>

<% roast_hint =
  case roast_key
  when "light"       then "爽やかな酸味と、フルーティーな香りが際立つ焙煎度(焼き加減)。"
  when "medium"      then "酸味・苦味・コクをバランスよく味わえる焙煎度(焼き加減)。"
  when "medium_dark" then "柔らかな苦味と甘いコクが調和した、酸味控えめで落ち着きのある焙煎度(焼き加減)。"
  when "dark"        then "力強い苦味と重厚なコクと甘み、芳醇な香りがしっかり感じられる焙煎度(焼き加減)。"
  else "焙煎度によって、味の傾向が変わります。"
  end
%>

<div class="max-w-3xl mx-auto py-10 px-4">
  <h1 class="text-2xl font-semibold mb-6 text-center">
    あなたのコーヒー味覚診断結果
  </h1>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
    <div class="flex items-center justify-between gap-3">
      <p class="text-sm text-gray-600">
        診断日：<%= l @taste_profile.diagnosed_at, format: :long %>
      </p>

      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
        <%= tagline %>
      </span>
    </div>

    <p class="text-lg font-semibold">
      まずは「<%= roast_label %>」のコーヒーから試すのがおすすめです。
    </p>

    <p class="text-sm text-gray-800 leading-relaxed">
      <%= @taste_profile.description %>
    </p>

    <details class="rounded-lg border border-gray-200 bg-gray-50 p-4">
      <summary class="cursor-pointer text-sm font-semibold text-gray-800">
        「<%= roast_label %>」って何？
      </summary>
      <p class="text-sm text-gray-700 mt-2 leading-relaxed">
        <%= roast_hint %>
      </p>
    </details>

  </div>

  <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">

    <%= link_to "もう一度診断する",
                new_taste_diagnosis_path,
                class: "px-4 py-2 rounded-full text-sm font-semibold border border-amber-700 text-amber-700 hover:bg-amber-50 text-center" %>

    <%= link_to "マイページへ戻る",
                mypage_path,
                class: "px-4 py-2 rounded-full text-sm font-semibold border border-amber-700 text-white bg-amber-700 hover:bg-amber-800 text-center" %>
  </div>
</div>
