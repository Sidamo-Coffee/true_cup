<div class="max-w-4xl mx-auto py-10 px-4 space-y-8">
  <div class="flex items-center justify-between">
    <% page_title_key = (@scope == "liked") ? "liked" : "all" %>
    <h1 class="text-2xl font-semibold"><%= t(".title.#{page_title_key}") %></h1>
  </div>

  <!-- タブ：全記録 / ★4以上 -->
  <div class="inline-flex rounded-full border bg-white p-1">
    <%= link_to t(".tabs.all"),
                preferences_path(scope: "all"),
                class: "px-4 py-2 rounded-full text-sm font-semibold transition " +
                       (@scope == "all" ? "bg-amber-700 text-white" : "text-gray-700 hover:bg-gray-50") %>

    <%= link_to t(".tabs.liked"),
                preferences_path(scope: "liked"),
                class: "px-4 py-2 rounded-full text-sm font-semibold transition " +
                       (@scope == "liked" ? "bg-amber-700 text-white" : "text-gray-700 hover:bg-gray-50") %>
  </div>

  <% if !@preference[:available] %>
    <div class="rounded border p-4">
      <%= t(".empty") %>
    </div>
  <% else %>
    <%# サマリー。焙煎度の傾向が出せない場合は見出しが無く空箱になるため、カードごと省く %>
    <% if @preference[:roast_available] %>
      <div class="rounded-xl border bg-white p-6 shadow-sm space-y-2">
        <% summary_suffix_key = (@scope == "liked") ? "liked" : "all" %>
        <p class="text-lg font-semibold text-amber-800">
          <% labels = @preference[:summary_roast_labels] %>
          <% if !@preference[:summary_tied] %>
            <%= t(".summary.text", roast: @preference[:summary_roast],
                  suffix: t(".summary.suffix.#{summary_suffix_key}")) %>
          <% elsif labels.size == 2 %>
            <%= t(".summary.tied_two", first: labels.first, second: labels.second,
                  suffix: t(".summary.suffix_tied.#{summary_suffix_key}")) %>
          <% else %>
            <%= t(".summary.tied_many", suffix: t(".summary.suffix_tied.#{summary_suffix_key}")) %>
          <% end %>
        </p>

        <p class="text-sm text-gray-600">
          <%= @preference[:reason] %>
        </p>
      </div>
    <% end %>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- 焙煎度（円グラフ） -->
      <div class="rounded-xl border bg-white p-6 shadow-sm wrapper w-full overflow-hidden">
        <h2 class="text-lg font-semibold mb-1"><%= t(".charts.roast.title") %></h2>
        <% if @preference[:roast_available] %>
          <p class="text-xs text-gray-500 mb-3"><%= @preference[:charts_reason] %></p>
          <%= pie_chart @preference[:roast_pie], donut: true, legend: "bottom", height: "260px", width: "100%",
                        library: { responsive: true, maintainAspectRatio: false,
                                   animation: { duration: 800, easing: "easeInOutQuart" } } %>
          <% if @preference[:unknown_roast_count].to_i.positive? %>
            <p class="text-xs text-gray-500 mt-3">
              <%= t(".charts.roast.unknown_note", count: @preference[:unknown_roast_count]) %>
            </p>
          <% end %>
        <% else %>
          <%# 焙煎度を記録した分が0件。味の傾向は右側に表示されている %>
          <div class="py-8 text-center">
            <%= render "shared/illustrations/coffee_empty" %>
            <p class="text-sm text-gray-600 mt-4 leading-relaxed">
              <%= t(".charts.roast.unknown_only") %>
            </p>
          </div>
        <% end %>
      </div>

      <!-- 味（棒グラフ） -->
      <div class="rounded-xl border bg-white p-6 shadow-sm wrapper w-full overflow-hidden">
        <h2 class="text-lg font-semibold mb-1"><%= t(".charts.taste.title") %></h2>
        <p class="text-xs text-gray-500 mb-3"><%= t(".charts.taste.note") %></p>
        <%= column_chart @preference[:taste_bar], min: 0, max: 10, height: "260px", width: "100%",
                         library: { responsive: true, maintainAspectRatio: false,
                                    animation: { duration: 800, easing: "easeInOutQuart" } } %>
      </div>
    </div>

    <% if @diagnosis_gap[:available] %>
      <%= render "diagnosis_gap", gap: @diagnosis_gap %>
    <% end %>

    <!-- Top3ランキング（焙煎度の集計なので、記録がある場合のみ） -->
    <% if @preference[:roast_available] %>
    <div class="rounded-xl border bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold mb-4"><%= t(".ranking.title") %></h2>

      <div class="space-y-3">
        <% @preference[:ranking].each do |item| %>
          <div class="flex items-center justify-between rounded-lg border p-4">
            <div>
              <%# 同数なら同じ順位。並び順で優劣がついたように見せない（#144） %>
              <p class="text-sm text-gray-500">#<%= item[:rank] %></p>
              <p class="text-lg font-semibold text-gray-900"><%= item[:label] %></p>
              <p class="text-sm text-gray-600">
                <%= t(".ranking.row", percent: item[:percent], count: item[:count]) %>
              </p>
            </div>
          </div>
        <% end %>
      </div>

      <p class="text-xs text-gray-500 mt-4">
        <%= t(".ranking.note") %>
      </p>
    </div>
    <% end %>
  <% end %>
</div>
