<% content_for :title, t(".title") %>

<div class="max-w-3xl mx-auto py-10 px-4">
  <h1 class="text-2xl font-semibold mb-6 text-center">
    <%= t(".heading") %>
  </h1>

  <p class="text-xs text-gray-700 mb-8 mt-1 text-center leading-relaxed">
    <%= t(".lead_html") %>
  </p>

  <%= form_with url: @form_url, method: :post, local: true do %>
    <div class="space-y-8">
      <% @questions.each_with_index do |question, index| %>
        <% q_key = question[:key] %>

        <section class="bg-white rounded-xl shadow-sm p-6">
          <h2 class="text-base font-semibold mb-4">
            <%= t(".question_title", number: index + 1, title: t("taste_diagnoses.questions.#{q_key}.title")) %>
          </h2>

          <div class="space-y-3">
            <% question[:options].each do |opt| %>
              <label class="flex items-center gap-3 cursor-pointer">
                <%= radio_button_tag "answers[#{q_key}]",
                                     opt,
                                     false,
                                     class: "h-4 w-4 border-gray-300" %>
                <span class="text-sm text-gray-800">
                  <%= t("taste_diagnoses.questions.#{q_key}.options.#{opt}") %>
                </span>
              </label>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>

    <div class="mt-10 text-center">
      <%= submit_tag t(".submit"),
                     class: "inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-semibold bg-amber-700 text-white hover:bg-amber-800 transition" %>
    </div>
  <% end %>
</div>
