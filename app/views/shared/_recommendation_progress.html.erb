<%# 次の段階までの進み具合（#122）。progress が nil のときは呼び出し側で出し分ける %>
<div class="space-y-2">
  <div class="flex items-baseline justify-between gap-2">
    <p class="text-xs font-semibold text-amber-800">
      <%= t("services.recommended_roast.progress.label.#{progress[:stage]}") %>
    </p>
    <p class="shrink-0 text-xs text-gray-500">
      <%= progress[:current] %> / <%= progress[:target] %>
    </p>
  </div>

  <div class="h-1.5 w-full overflow-hidden rounded-full bg-stone-200">
    <div class="h-full rounded-full bg-amber-600 transition-[width] duration-700 ease-out"
         style="width: <%= progress[:percent] %>%"></div>
  </div>

  <p class="text-xs text-gray-500 leading-relaxed">
    <% if progress[:remaining].zero? %>
      <%= t("services.recommended_roast.progress.done") %>
    <% else %>
      <%= t("services.recommended_roast.progress.remaining.#{progress[:stage]}", count: progress[:remaining]) %>
    <% end %>
  </p>
</div>
