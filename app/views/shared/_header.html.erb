<header class="border-b border-stone-200 bg-amber-50">
  <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
    <!-- ロゴ -->
    <div class="flex items-baseline gap-2">
      <% if user_signed_in? %>
        <%= link_to mypage_path, class: "text-lg md:text-xl font-semibold tracking-tight text-stone-900" do %>
          TrueCup
        <% end %>
      <% else %>
        <%= link_to root_path, class: "text-lg md:text-xl font-semibold tracking-tight text-stone-900" do %>
          TrueCup
        <% end %>
      <% end %>
      <span class="hidden sm:inline text-[11px] text-stone-500">
        <%= t(".tagline") %>
      </span>
    </div>

    <!-- ナビゲーション -->
    <nav class="flex items-center gap-2 md:gap-3 text-xs md:text-sm">
      <% if user_signed_in? %>
      <!-- ログイン後ナビ -->
        <%= link_to t(".nav.new_log"),
            new_coffee_log_path,
            class: "inline-flex items-center justify-center rounded-full
                    px-3 py-1.5 md:px-4 md:py-2 font-semibold
                    text-amber-50 bg-amber-700 hover:bg-amber-800 transition" %>
        <!-- md以上ではフルナビ、モバイルはメニューに格納 -->
        <div class="hidden md:flex items-center gap-3">
          <%= link_to t(".nav.logs"),
                coffee_logs_path,
                class: "text-stone-700 hover:text-stone-900 px-2 py-1" %>

          <%= link_to t(".nav.preferences"),
                preferences_path,
                class: "text-stone-700 hover:text-stone-900 px-2 py-1" %>

          <%= link_to t(".nav.mypage"),
                mypage_path,
                class: "text-stone-700 hover:text-stone-900 px-2 py-1" %>

          <%= button_to t(".nav.logout"),
                destroy_user_session_path,
                method: :delete,
                form: { data: { turbo: false } },
                class: "text-stone-600 hover:text-stone-900 px-2 py-1 cursor-pointer" %>
        </div>
        <!-- モバイル用メニュー（JS不要） -->
        <details class="md:hidden relative">
          <summary class="list-none inline-flex items-center justify-center rounded-full px-3 py-1.5 font-semibold border border-stone-300 text-stone-700 hover:bg-stone-50 transition cursor-pointer">
            <%= t(".menu") %>
          </summary>

          <div class="absolute right-0 mt-2 w-44 rounded-xl border bg-white shadow-lg p-2 z-50">
            <%= link_to t(".nav.mypage"),
                  mypage_path,
                  class: "block px-3 py-2 rounded-lg text-sm text-stone-700 hover:bg-stone-50" %>

            <%= link_to t(".nav.logs"),
                  coffee_logs_path,
                  class: "block px-3 py-2 rounded-lg text-sm text-stone-700 hover:bg-stone-50" %>

            <%= link_to t(".nav.preferences"),
                  preferences_path,
                  class: "block px-3 py-2 rounded-lg text-sm text-stone-700 hover:bg-stone-50" %>

            <div class="my-1 border-t"></div>

            <%= button_to t(".nav.logout"),
                  destroy_user_session_path,
                  method: :delete,
                  form: { data: { turbo: false } },
                  class: "w-full text-left px-3 py-2 rounded-lg text-sm text-stone-700 hover:bg-stone-50 cursor-pointer" %>
          </div>
        </details>
      <% else %>
        <!-- ログイン前ナビ -->
        <%= link_to t(".nav.about"),
              root_path,
              class: "hidden sm:inline text-stone-700 hover:text-stone-900" %>

        <%= link_to t(".nav.login"),
              new_user_session_path,
              class: "text-stone-700 hover:text-stone-900" %>

        <%= link_to t(".nav.signup"),
              new_user_registration_path,
              class: "inline-flex items-center justify-center rounded-full 
                       px-3 py-1.5 md:px-4 md:py-2 font-semibold 
                       text-amber-50 bg-amber-700 hover:bg-amber-800 transition" %>
      <% end %>
    </nav>
  </div>
</header>
