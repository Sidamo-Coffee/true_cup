<div class="max-w-md mx-auto py-10 px-4">
  <h1 class="text-2xl font-semibold mb-6 text-center">新しいパスワードの設定</h1>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <%= form_for(resource,
                 as: resource_name,
                 url: password_path(resource_name),
                 html: { method: :put, class: "space-y-4" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div>
        <div class="flex items-baseline gap-2 mb-1">
          <%= f.label :password, "新しいパスワード", class: "block text-sm font-medium" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500">
              （<%= @minimum_password_length %>文字以上）
            </p>
          <% end %>
        </div>
        <%= f.password_field :password,
              autofocus: true,
              autocomplete: "new-password",
              class: "w-full rounded border px-3 py-2" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "新しいパスワード（確認用）",
              class: "block text-sm font-medium mb-1" %>
        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "w-full rounded border px-3 py-2" %>
      </div>

      <div class="pt-2">
        <%= f.submit "パスワードを変更",
              class: "w-full rounded bg-amber-700 px-4 py-2 text-white font-semibold hover:bg-amber-800 transition" %>
      </div>
    <% end %>
  </div>

  <div class="mt-6 text-center text-sm text-gray-600">
    <%= link_to "ログインページに戻る", new_session_path(resource_name), class: "hover:underline" %>
  </div>
</div>