<div class="space-y-16">
  <!-- ヒーローセクション -->
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto space-y-6 text-center">
      <%= render "shared/illustrations/coffee_hero" %>
      <p class="inline-block text-xs md:text-sm tracking-wide uppercase text-amber-700 font-semibold">
        <%= t(".hero.kicker") %>
      </p>
      <h1 class="text-2xl md:text-4xl font-bold leading-relaxed">
        <%= t(".hero.heading_html") %>
      </h1>
      <p class="text-sm md:text-lg leading-relaxed text-stone-700">
        <%= t(".hero.lead_html") %>
      </p>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 justify-center">
        <%= link_to t("static_pages.top.hero.cta_trial"),
            trial_diagnosis_path,
            class: "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-amber-50 bg-amber-700 hover:bg-amber-800 transition" %>
        <%= link_to t(".hero.cta_signup"),
            new_user_registration_path,
            class: "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold border-2 border-amber-700 text-amber-700 hover:bg-amber-50 transition" %>
        <%= link_to t(".hero.cta_login"), new_user_session_path,
            class: "text-sm font-medium underline underline-offset-4 text-amber-800 hover:text-amber-900" %>
      </div>
    </div>
  </section>
  <!-- サービスへの思い -->
  <section class="bg-amber-100/60 rounded-2xl px-6 py-8 md:px-10 md:py-10">
    <h2 class="text-xl md:text-2xl font-semibold mb-4">
        <%= t(".belief.heading") %>
    </h2>
    <div class="space-y-4 text-sm md:text-base leading-relaxed">
      <p>
        <p><%= t(".belief.p1") %></p>
      </p>
      <p>
        <p><%= t(".belief.p2") %></p>
      <p>
        <p><%= t(".belief.p3") %></p>
      </p>
    </div>
  </section>
  <!-- 利用ステップ -->
  <section class="space-y-8">
    <header class="space-y-2 text-center">
      <h2 class="text-2xl font-semibold"><%= t(".steps.heading") %></h2>
      <p class="text-xs md:text-sm text-stone-600"><%= t(".steps.lead") %></p>
    </header>
    <div class="grid gap-6 md:grid-cols-3">
      <!-- STEP 1 -->
      <div class="bg-white rounded-2xl border border-amber-100 p-6 space-y-3 shadow-sm">
        <p class="text-xs font-semibold tracking-wide text-amber-700"><%= t(".steps.step1.label") %></p>
        <h3 class="font-semibold"><%= t(".steps.step1.title") %></h3>
        <p class="text-sm leading-relaxed text-stone-700"><%= t(".steps.step1.body") %></p>
      </div>
      <!-- STEP 2 -->
      <div class="bg-white rounded-2xl border border-amber-100 p-6 space-y-3 shadow-sm">
        <p class="text-xs font-semibold tracking-wide text-amber-700"><%= t(".steps.step2.label") %></p>
        <h3 class="font-semibold"><%= t(".steps.step2.title") %></h3>
        <p class="text-sm leading-relaxed text-stone-700"><%= t(".steps.step2.body") %></p>
      </div>
      <!-- STEP 3 -->
      <div class="bg-white rounded-2xl border border-amber-100 p-6 space-y-3 shadow-sm">
        <p class="text-xs font-semibold tracking-wide text-amber-700"><%= t(".steps.step3.label") %></p>
        <h3 class="font-semibold"><%= t(".steps.step3.title") %></h3>
        <p class="text-sm leading-relaxed text-stone-700"><%= t(".steps.step3.body") %></p>
      </div>
    </div>
  </section>
  <!-- クロージング -->
  <section class="bg-stone-800 text-amber-50 rounded-2xl px-6 py-10 md:px-10 md:py-12 text-center space-y-6">
    <p class="text-base md:text-lg leading-relaxed">
      <%= t(".closing.message_html") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
      <%= link_to t(".closing.cta_signup"), new_user_registration_path,
          class: "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold text-stone-900 bg-amber-200 hover:bg-amber-300 transition" %>
      <%= link_to t(".closing.cta_trial"), trial_diagnosis_path,
          class: "inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold border-2 border-amber-200 text-amber-50 hover:bg-amber-100 transition" %>
      <%= link_to t(".closing.cta_login"), new_user_session_path,
          class: "text-xs md:text-sm font-medium underline underline-offset-4" %>
    </div>
  </section>
</div>
