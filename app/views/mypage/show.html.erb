<%= render "shared/onboarding_modal" %>

<div class="max-w-3xl mx-auto py-10 px-4 space-y-8">
  <!-- ヘッダー（挨拶） -->
  <section>
    <div class="flex items-center gap-3">
      <%= render "shared/illustrations/coffee_icon" %>
      <h1 class="text-xl sm:text-2xl font-semibold">
        <%= t(".greeting", name: (@user.name.presence || @user.email)) %>
      </h1>
    </div>

    <p class="text-sm text-gray-600 mt-1">
      <%= t(".intro") %>
    </p>

    <button
      onclick="document.querySelector('[data-onboarding-target=modal]').classList.remove('hidden'); document.body.classList.add('overflow-hidden')"
      class="mt-2 inline-flex items-center gap-1 text-xs text-gray-400 hover:text-gray-600 transition underline underline-offset-2"
      type="button"
    >
      <%= t(".actions.show_onboarding") %>
    </button>
  </section>

  <% if @taste_profile.present? %>
    <%= link_to taste_profile_path,
                class: "inline-flex items-center gap-1 mt-3 text-xs font-semibold
                        px-3 py-1.5 rounded-full border border-gray-300
                        text-gray-700 hover:bg-gray-50 transition w-fit" do %>
      <%= t(".taste_link", label: @taste_profile.preferred_roast_label) %>
      <span class="text-gray-400">→</span>
    <% end %>
  <% end %>

  <!-- おすすめ焙煎度 -->
  <section class="bg-white rounded-xl shadow-sm p-6">
    <%# 根拠バッジが長く、横並びのままだと見出しが1文字ずつ折り返す。
        狭い幅では縦に積み、見出しは縮ませない %>
    <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-center sm:justify-between mb-2">
      <h2 class="text-lg font-semibold shrink-0"><%= t(".sections.recommendation") %></h2>
      <% if @recommended_roast&.dig(:available) %>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-amber-50 text-amber-800">
          <%= @recommended_roast[:reason] %>
          <% if @recommended_roast[:n].to_i > 0 %>
            <%= t(".recommendation.total_count", count: @recommended_roast[:n]) %>
          <% end %>
        </span>
      <% end %>
    </div>
    <% if @recommended_roast&.dig(:available) %>
      <p class="text-2xl font-semibold text-amber-800">
        <%= @recommended_roast[:label] %>
      </p>
      <% if @recommended_roast[:message].present? %>
        <p class="text-sm text-gray-700 mt-2 mb-2">
          <%= @recommended_roast[:message] %>
        </p>
        <p class="text-xs text-gray-600 mb-2">
          <%= t(".recommendation.notice_update") %>
        </p>
      <% end %>
      <% if @roast_guide.present? %>
        <div class="mt-4 space-y-3">
          <div>
            <p class="text-sm font-semibold text-gray-900"><%= t(".recommendation.words_title") %></p>
            <div class="mt-2 flex flex-wrap gap-2">
              <% @roast_guide[:words].each do |w| %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                  <%= w %>
                </span>
              <% end %>
            </div>
          </div>

          <div>
            <p class="text-sm font-semibold text-gray-900"><%= t(".recommendation.tell_title") %></p>
            <p class="mt-2 text-sm text-gray-700">
              「<%= @roast_guide[:tell] %>」
            </p>
          </div>
        </div>
      <% end %>
      <% if @recommended_roast[:notice].present? %>
        <p class="text-xs text-gray-500 mt-4 leading-relaxed">
          <%= @recommended_roast[:notice] %>
        </p>
      <% end %>
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <%= link_to t(".actions.record"),
                    new_coffee_log_path,
                    class: "inline-flex items-center justify-center px-4 py-3 rounded-full text-sm font-semibold bg-amber-700 text-white hover:bg-amber-800 transition w-full sm:w-auto" %>
        <%= link_to t(".actions.insights_detail"),
                    preferences_path,
                    class: "inline-flex items-center justify-center px-4 py-3 rounded-full text-sm font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition w-full sm:w-auto" %>
      </div>
    <% else %>
      <p class="text-sm text-gray-700">
        <%= t(".recommendation.no_recommendation") %>
      </p>
      <div class="mt-4 flex flex-col sm:flex-row gap-3">
        <% if @taste_profile.present? %>
          <%= link_to t(".actions.first_log"),
                      new_coffee_log_path,
                      class: "inline-flex items-center justify-center px-4 py-3 rounded-full text-sm font-semibold bg-amber-700 text-white hover:bg-amber-800 transition w-full sm:w-auto" %>
        <% else %>
          <%= link_to t(".actions.start_diagnosis"),
                      new_taste_diagnosis_path,
                      class: "inline-flex items-center justify-center px-4 py-3 rounded-full text-sm font-semibold bg-amber-700 text-white hover:bg-amber-800 transition w-full sm:w-auto" %>
        <% end %>
      </div>
    <% end %>
  </section>
  
  <!-- コーヒーの傾向（簡易表示） -->
  <section class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center sm:justify-between gap-3 mb-4">
      <h2 class="text-lg font-semibold min-w-0"><%= t(".sections.insights") %></h2>
      <%= link_to t(".actions.to_detail"),
                  preferences_path,
                  class: "shrink-0 inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition" %>
    </div>
  
    <div class="grid md:grid-cols-2 gap-4">
      <!-- （全記録） -->
      <div class="rounded-lg border p-4 space-y-2 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-semibold text-gray-900 min-w-0"><%= t(".insights.all_title") %></p>
        </div>

        <% if @preference_all[:roast_available] %>
          <p class="text-base font-semibold text-amber-800">
            <% labels = @preference_all[:summary_roast_labels] %>
            <% if !@preference_all[:summary_tied] %>
              <%= t(".insights.summary_roast", roast: @preference_all[:summary_roast]) %>
            <% elsif labels.size == 2 %>
              <%= t(".insights.summary_roast_tied_two", first: labels.first, second: labels.second) %>
            <% else %>
              <%= t(".insights.summary_roast_tied_many") %>
            <% end %>
          </p>
          <p class="text-xs text-gray-500">
            <%= t(".insights.target_count", count: @preference_all[:roast_logs_count]) %>
          </p>

          <div class="mt-2 w-full overflow-hidden min-w-0">
            <%= pie_chart @preference_all[:roast_pie],
                  donut: true,
                  height: "180px",
                  width: "100%",
                  legend: false,
                  library: { responsive: true, maintainAspectRatio: false } %>
          </div>
        <% elsif @preference_all[:available] %>
          <%# 記録はあるが、焙煎度が全て「不明」 %>
          <p class="text-sm text-gray-600 leading-relaxed">
            <%= t(".insights.unknown_roast_only") %>
          </p>
        <% else %>
          <p class="text-sm text-gray-600 leading-relaxed">
            <%= t(".insights.empty_all") %>
          </p>
          <%= link_to t(".actions.record"),
                      new_coffee_log_path,
                      class: "inline-flex items-center justify-center px-3 py-2 rounded-full text-xs font-semibold bg-amber-700 text-white hover:bg-amber-800 transition" %>
        <% end %>
      </div>

      <!-- 好き（★4以上） -->
      <div class="rounded-lg border p-4 space-y-2 min-w-0">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-semibold text-gray-900 min-w-0"><%= t(".insights.liked_title") %></p>
        </div>

        <% if @preference_liked[:roast_available] %>
          <p class="text-base font-semibold text-amber-800">
            <% labels = @preference_liked[:summary_roast_labels] %>
            <% if !@preference_liked[:summary_tied] %>
              <%= t(".insights.summary_roast", roast: @preference_liked[:summary_roast]) %>
            <% elsif labels.size == 2 %>
              <%= t(".insights.summary_roast_tied_two", first: labels.first, second: labels.second) %>
            <% else %>
              <%= t(".insights.summary_roast_tied_many") %>
            <% end %>
          </p>
          <p class="text-xs text-gray-500">
            <%= t(".insights.target_count", count: @preference_liked[:roast_logs_count]) %>
          </p>
          <div class="mt-2 w-full overflow-hidden min-w-0">
            <%= pie_chart @preference_liked[:roast_pie],
            donut: true,
            height: "160px",
            width: "100%",
            legend: false,
            library: { responsive: true, maintainAspectRatio: false } %>
          </div>
        <% elsif @preference_liked[:available] %>
          <%# ★4以上の記録はあるが、焙煎度が全て「不明」 %>
          <p class="text-sm text-gray-600 leading-relaxed">
            <%= t(".insights.unknown_roast_only") %>
          </p>
        <% else %>
          <p class="text-sm text-gray-600 leading-relaxed">
            <%= t(".insights.empty_liked") %>
          </p>
        <% end %>
      </div>
    </div>

    <%# 次の段階までの進み具合。おすすめの確からしさ（notice）は、
        何を修飾しているか分かるようおすすめカード側に置いている（#143） %>
    <% if @recommended_roast[:progress].present? %>
      <div class="mt-4">
        <%= render "shared/recommendation_progress", progress: @recommended_roast[:progress] %>
      </div>
    <% end %>
  </section>

  <!-- コーヒー記録エリア -->
  <section class="bg-white rounded-xl shadow-sm p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold"><%= t(".sections.recent_logs") %></h2>
      <div class="flex gap-2">
        <%= link_to t(".actions.logs_index"),
                    coffee_logs_path,
                    class: "inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-300 text-gray-700 hover:bg-gray-50 transition" %>

        <%= link_to t(".actions.new_log"),
                    new_coffee_log_path,
                    class: "inline-flex items-center px-3 py-1.5 rounded-full text-xs font-semibold bg-amber-700 text-white hover:bg-amber-800 transition" %>
      </div>
    </div>

    <% if @recent_coffee_logs.any? %>
      <div class="space-y-3">
        <% @recent_coffee_logs.each do |log| %>
          <%= link_to coffee_log_path(log),
                      class: "block rounded-lg border p-4 hover:bg-gray-50 transition" do %>

            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="text-xs text-gray-500">
                  <%= l log.drank_on, format: :long %>
                  ・<%= log.place_label %>
                  <% if log.place_cafe? && log.cafe_name.present? %>
                    （<%= log.cafe_name %>）
                  <% end %>
                </p>

                <p class="font-semibold text-gray-900 truncate mt-1">
                  <%= log.coffee_name.presence || t(".recent_logs.coffee_name_blank") %>
                </p>

                <div class="mt-2 flex flex-wrap gap-2 text-xs">
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-700">
                     <%= t(".chips.acidity") %>：<%= t("common.taste_levels.strength")[log.acidity] %>
                  </span>
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-700">
                    <%= t(".chips.bitterness") %>：<%= t("common.taste_levels.strength")[log.bitterness] %>
                  </span>
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-700">
                    <%= t(".chips.rating") %>：<%= "★" * log.overall_rating %>
                  </span>
                </div>

                <% if log.memo.present? %>
                  <p class="text-sm text-gray-600 mt-2 line-clamp-2"><%= log.memo %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>

      <div class="mt-4">
        <%= link_to t(".actions.more"),
                    coffee_logs_path,
                    class: "text-sm text-gray-700 hover:underline" %>
      </div>
    <% else %>
      <p class="text-sm text-gray-600 mb-4">
        <%= t(".recent_logs.empty") %>
      </p>

      <%= link_to t(".actions.first_log"),
                  new_coffee_log_path,
                  class: "inline-flex items-center justify-center px-4 py-2 rounded-full text-sm font-semibold bg-amber-700 text-white hover:bg-amber-800 transition" %>
    <% end %>
  </section>
  <section class="bg-white rounded-xl shadow-sm p-6">
    <h2 class="text-lg font-semibold mb-4">アカウント設定</h2>
    
    <div class="space-y-4">
      <!-- パスワード変更 -->
      <div class="flex items-center justify-between py-3 border-b">
        <div>
          <p class="font-medium text-gray-900">パスワード変更</p>
          <p class="text-sm text-gray-600">現在のパスワードを変更できます</p>
        </div>
        <%= link_to "変更する",
                    edit_user_registration_path,
                    class: "px-4 py-2 rounded border text-sm hover:bg-gray-50 transition" %>
      </div>
      
      <!-- アカウント削除 -->
      <div class="flex items-center justify-between py-3">
        <div>
          <p class="font-medium text-red-700">アカウントの削除</p>
          <p class="text-sm text-gray-600">
            アカウントを削除すると、全てのデータが完全に削除されます
          </p>
        </div>
        <%= link_to "削除する",
                    confirm_deletion_user_registration_path,
                    class: "px-4 py-2 rounded border border-red-300 text-red-700 text-sm hover:bg-red-50 transition" %>
      </div>
    </div>
  </section>
</div>